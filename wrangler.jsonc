{
  // Cloudflare Workers Configuration
  "name": "dassreal-workers",
  "type": "service",
  "main": "src/index.ts",
  
  // Environment Configuration
  "env": {
    "production": {
      "name": "dassreal-production",
      "routes": [
        {
          "pattern": "dassreal.com/*",
          "zone_name": "dassreal.com"
        }
      ],
      "vars": {
        "ADMIN_EMAIL": "Long@dassreal.com",
        "ENVIRONMENT": "production",
        "LOG_LEVEL": "info"
      },
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "",
          "preview_id": ""
        },
        {
          "binding": "CONFIG",
          "id": "",
          "preview_id": ""
        }
      ]
    }
  },

  // Build Configuration
  "build": {
    "command": "npm run build",
    "cwd": "./",
    "main": "src/index.ts"
  },

  // Account Configuration
  "account_id": "",
  "workers_dev": true,
  "compatibility_date": "2026-01-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Triggers and Cron Jobs
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },

  // Site Configuration (if applicable)
  "site": {
    "bucket": "./public"
  },

  // Observability
  "observability": {
    "enabled": true
  },

  // Cloudflare Account Email
  "_comment": "Cloudflare Account: nguyencaothanglonger@gmail.com | Last Updated: 2026-01-14 15:19:18 UTC"
}
